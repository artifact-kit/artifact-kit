{
  "name": "@artifact-kit/deckkit",
  "version": "0.1.1",
  "description": "Artifact Kit core library for PowerPoint deck generation.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "author": {
    "name": "Artifact Kit"
  },
  "homepage": "https://github.com/artifact-kit/artifact-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artifact-kit/artifact-kit.git",
    "directory": "packages/deckkit"
  },
  "keywords": [
    "artifact-kit",
    "pptx",
    "powerpoint",
    "presentation",
    "node"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
